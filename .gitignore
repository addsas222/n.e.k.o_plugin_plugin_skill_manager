__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/
vendor/
dist/
build/
*.egg-info/
store.db
.env
.DS_Store

# --- 运行期状态（宿主生成，不是源码）---------------------------------------
# config/plugin.toml 由宿主从 config.example.toml 逐字节复制而来，
# 用户改的是那一份；data/store.db 是运行期存储。都不进仓库。
config/
data/
cache/
static/cache/

# --- 外部 Skill 是运行期创建的目录联接，必须挡住 ---------------------------
# 宿主启动时会把用户文件夹里的 Skill 以 junction 形式挂到 skills/ 下。
# **Git 会跟随 junction**，把目标目录里的文件当普通文件提交 —— 不放行白名单的话，
# 一次 git add 就会把用户整个 skill 根目录（实测 94 个、含 261 MB 的 .pyz）
# 拖进仓库。所以只放行随包自带的这 5 个真实目录。
skills/*/
!skills/database-export/
!skills/database-query/
!skills/knowledge-import/
!skills/knowledge-search/
!skills/neko-plugin-dev/

# --- pytest tmp_path 残留目录 ----------------------------------------------
pytest-cache-files-*/
